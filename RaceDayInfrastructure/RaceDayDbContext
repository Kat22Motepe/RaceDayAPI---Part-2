using Microsoft.EntityFrameworkCore;
using RaceDay.Domain;

namespace RaceDay.Infrastructure;

public class RaceDayDbContext : DbContext
{
    // This tells EF Core how to connect to the database.
    public RaceDayDbContext(DbContextOptions<RaceDayDbContext> options) : base(options) { }

    // These are our "Filing Cabinet Drawers" (Tables)
    public DbSet<User> Users => Set<User>();
    public DbSet<Event> Events => Set<Event>();
    public DbSet<Category> Categories => Set<Category>();
    public DbSet<Enrolment> Enrolments => Set<Enrolment>();
    public DbSet<Result> Results => Set<Result>();
    public DbSet<Session> Sessions => Set<Session>();

    // This is the Rule Book (Relationships and Rules)
    protected override void OnModelCreating(ModelBuilder mb)
    {
        // Emails must be unique
        mb.Entity<User>().HasIndex(u => u.Email).IsUnique();

        // Session tokens must be unique
        mb.Entity<Session>().HasIndex(s => s.Token).IsUnique();

        // A participant can only enrol ONCE per event
        mb.Entity<Enrolment>().HasIndex(e => new { e.ParticipantId, e.EventId }).IsUnique();

        // An enrolment can only have ONE result
        mb.Entity<Result>().HasIndex(r => r.EnrolmentId).IsUnique();

        // Relationships (Delete Behaviour rules)
        mb.Entity<Event>()
          .HasOne(e => e.Organiser)
          .WithMany(u => u.OrganisedEvents)
          .HasForeignKey(e => e.OrganiserId)
          .OnDelete(DeleteBehavior.Restrict);

        mb.Entity<Enrolment>()
          .HasOne(e => e.Participant)
          .WithMany(u => u.Enrolments)
          .HasForeignKey(e => e.ParticipantId)
          .OnDelete(DeleteBehavior.Restrict);

        mb.Entity<Enrolment>()
          .HasOne(e => e.Event)
          .WithMany(e => e.Enrolments)
          .HasForeignKey(e => e.EventId)
          .OnDelete(DeleteBehavior.Restrict);

        mb.Entity<Enrolment>()
          .HasOne(e => e.Category)
          .WithMany(c => c.Enrolments)
          .HasForeignKey(e => e.CategoryId)
          .OnDelete(DeleteBehavior.Restrict);

        mb.Entity<Result>()
          .HasOne(r => r.Enrolment)
          .WithOne(e => e.Result)
          .HasForeignKey<Result>(r => r.EnrolmentId)
          .OnDelete(DeleteBehavior.Cascade);

        base.OnModelCreating(mb);
    }
}
